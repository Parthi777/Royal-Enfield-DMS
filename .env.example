# Copy to Railway -> your service -> Variables (not needed for DEMO_MODE)

# Whole service-account key file (paste the JSON as-is, or base64 of it)
GOOGLE_SERVICE_ACCOUNT_JSON=
# OAuth "Web application" client ID used for "Sign in with Google"
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Any long random text (keeps people signed in across restarts)
SESSION_SECRET=
# Always Admin, even if the Users tab is empty (comma separated)
ADMIN_EMAILS=you@gmail.com
# The RE Showroom Google Sheet: the part between /d/ and /edit in its link
SHEET_ID=the-long-id-in-your-sheet-link
SHOWROOM_NAME=Royal Enfield Showroom
NODE_ENV=production
# true = sample data in memory, no Google needed (for a first look)
DEMO_MODE=false
